const socket = io();
const $ = id => document.getElementById(id);
let myPlayerId = null, myRoom = null, latestState = null, toastTimer = null;
function showToast(message) { const el=$('toast'); el.textContent=message; el.style.display='block'; clearTimeout(toastTimer); toastTimer=setTimeout(()=>el.style.display='none',2600); }
function enterGame(data) { myRoom=data.code; myPlayerId=data.playerId; $('entry').classList.add('hidden'); $('game').classList.remove('hidden'); $('roomCodeLabel').textContent=myRoom; }
$('create').addEventListener('click',()=>{ $('entryError').textContent=''; socket.emit('createRoom',{name:$('name').value,team:$('team').value},r=>{if(!r?.ok){$('entryError').textContent='建立房間失敗，請再試一次。';return;}enterGame(r);}); });
$('join').addEventListener('click',()=>{ $('entryError').textContent=''; socket.emit('joinRoom',{code:$('roomCode').value,name:$('name').value,team:$('team').value},r=>{if(!r?.ok){$('entryError').textContent=r?.error||'加入失敗。';return;}enterGame(r);}); });
$('roomCode').addEventListener('input',e=>e.target.value=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6));
$('copyCode').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(myRoom);showToast('房間碼已複製：'+myRoom);}catch{showToast('請手動分享房間碼：'+myRoom);}});
$('spin').addEventListener('click',()=>{ $('spin').disabled=true; $('result').textContent='轉輪旋轉中…'; socket.emit('spin'); });
$('reset').addEventListener('click',()=>{if(confirm('確定要清除本局分數與紀錄，讓所有玩家重新開始嗎？'))socket.emit('resetGame');});
socket.on('connect',()=>{if($('connection'))$('connection').textContent='● 已連線';});
socket.on('disconnect',()=>{if($('connection'))$('connection').textContent='○ 連線中斷，請檢查網路';});
socket.on('gameError',message=>{showToast(message);if(latestState)render(latestState);});
function render(s){latestState=s;$('blueScore').textContent=s.scores.blue;$('redScore').textContent=s.scores.red;$('playerCount').textContent=`${s.players.length} / ${s.maxPlayers} 人`;const me=s.players.find(p=>p.id===myPlayerId);$('myIdentity').textContent=me?`${me.name}・${me.team==='blue'?'藍隊':'紅隊'}`:'玩家';$('remaining').textContent=me?`剩餘 ${me.spinsLeft} 次`:'尚未加入';$('spin').disabled=!(s.players.length===s.maxPlayers&&me&&me.spinsLeft>0&&s.status==='playing');
if(s.status==='finished')$('result').textContent=`🎉 本局結束：${s.scores.blue===s.scores.red?'平手！':s.scores.blue>s.scores.red?'🔵 藍隊獲勝！':'🔴 紅隊獲勝！'}`;else if(s.players.length<6)$('result').textContent=`還差 ${6-s.players.length} 位玩家加入`;else if(me&&me.spinsLeft===0)$('result').textContent='你已完成全部拉霸，等待其他玩家！';else if(!s.history.length)$('result').textContent='六位玩家到齊，準備開始！';
$('players').innerHTML='';s.players.forEach(p=>{const d=document.createElement('div');d.className=`player ${p.team} ${p.connected?'':'offline'}`;const dot=document.createElement('span');dot.className='dot';const n=document.createElement('span');n.className='pname';n.textContent=p.name+(p.id===myPlayerId?'（你）':'');const m=document.createElement('span');m.className='meta';m.textContent=`${p.connected?'在線':'離線'} · ${p.spinsUsed}/3 次`;d.append(dot,n,m);$('players').appendChild(d);});
$('history').innerHTML='';if(!s.history.length){const p=document.createElement('p');p.className='muted';p.textContent='還沒有拉霸紀錄。';$('history').appendChild(p);}else{[...s.history].reverse().forEach(item=>{const row=document.createElement('div');row.className='history-item';const n=document.createElement('span');n.className='name';n.textContent=`${item.team==='blue'?'🔵':'🔴'} ${item.playerName}`;const reels=document.createElement('span');reels.className='icons';reels.textContent=item.reels.join(' ');const pts=document.createElement('span');pts.className='points';pts.textContent=`+${item.points}`;row.append(n,reels,pts);$('history').appendChild(row);});const last=s.history[s.history.length-1];['reel0','reel1','reel2'].forEach((id,i)=>$(id).textContent=last.reels[i]);if(last.playerName===me?.name&&last.team===me?.team)$('result').textContent=`你拉出了 ${last.reels.join(' ')}，獲得 ${last.points} 分！`;}}
socket.on('state',render);
