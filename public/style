:root{color-scheme:dark;--bg:#10152b;--panel:#1b2340;--text:#f7f7ff;--muted:#aab2d0;--blue:#4b9cff;--red:#ff626f;--gold:#ffd66b}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#27315b 0,#10152b 60%);color:var(--text);font-family:system-ui,-apple-system,"Noto Sans TC",sans-serif;min-height:100vh}.app{width:min(100% - 24px,620px);margin:0 auto;padding:22px 0 40px}.hero{text-align:center;padding:14px 4px 22px}.eyebrow{font-size:.72rem;letter-spacing:.2em;color:var(--gold);font-weight:800}.hero h1{font-size:clamp(1.7rem,7vw,2.5rem);margin:9px 0}.hero p{margin:0;color:var(--muted)}.panel{background:rgba(27,35,64,.94);border:1px solid #394467;border-radius:20px;padding:18px;margin-bottom:14px;box-shadow:0 12px 32px #0002}.panel h2{font-size:1.1rem;margin:0 0 14px}label{display:block;font-size:.9rem;color:var(--muted);margin:12px 0}input,select{display:block;width:100%;margin-top:7px;background:#10162c;color:var(--text);border:1px solid #485477;border-radius:12px;padding:13px 12px;font-size:1rem;min-width:0}button{border:1px solid #566387;border-radius:12px;padding:12px 15px;background:#293454;color:var(--text);font-size:.95rem;font-weight:750;cursor:pointer}button:disabled{opacity:.42;cursor:not-allowed}.primary{background:linear-gradient(135deg,#ffb93e,#ff7c45);color:#25142a;border:0}.actions{margin:16px 0 12px}.actions button{width:100%}.joinline{display:flex;gap:8px;align-items:center}.joinline input{flex:1}.joinline button{white-space:nowrap}.hint{font-size:.8rem;line-height:1.55;color:var(--muted);margin:12px 0 0}.error{color:#ff9ba3;min-height:1.2em;font-size:.9rem}.hidden{display:none!important}.roombar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.roombar>div:first-child{display:flex;flex-direction:column;gap:2px;margin-right:auto}.roombar strong{font-size:1.25rem;letter-spacing:.15em;color:var(--gold)}.muted{color:var(--muted)}.small{font-size:.78rem;padding:9px}.connection{width:100%;font-size:.78rem;color:var(--muted)}.scoreboard{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;margin-bottom:14px}.score{border-radius:18px;padding:15px 10px;text-align:center;display:flex;align-items:center;justify-content:center;gap:5px;flex-wrap:wrap}.score.blue{background:#17345c;border:1px solid #3679c7}.score.red{background:#542b43;border:1px solid #b84962}.score span{width:100%;font-weight:800}.score strong{font-size:2.2rem;line-height:1.2}.score small{color:var(--muted)}.versus{font-size:.8rem;font-weight:900;color:var(--gold)}.slot-panel{text-align:center}.statusline{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:.85rem}.reels{display:flex;justify-content:center;gap:9px;margin:22px 0 12px}.reels span{display:grid;place-items:center;background:linear-gradient(#fff,#dfe5f5);color:#11172b;border:4px solid #ffca55;border-radius:15px;width:clamp(68px,21vw,100px);height:clamp(78px,24vw,112px);font-size:clamp(2.4rem,10vw,4rem);box-shadow:inset 0 0 0 3px #fff8,0 7px 0 #9b662d}.result{min-height:1.5em;font-weight:800;color:var(--gold);margin:18px 0}.spin{width:100%;padding:16px;font-size:1.1rem;box-shadow:0 5px 0 #a54e28}.spin:active{transform:translateY(2px);box-shadow:0 3px 0 #a54e28}.section-title{display:flex;justify-content:space-between;align-items:center;gap:8px}.section-title h2{margin:0}.section-title span{font-size:.8rem;color:var(--muted)}.players{display:grid;gap:8px}.player{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:12px;background:#11182e}.player .dot{width:10px;height:10px;border-radius:50%;flex:none}.player.blue .dot{background:var(--blue)}.player.red .dot{background:var(--red)}.player .pname{font-weight:750;flex:1;overflow-wrap:anywhere}.player .meta{font-size:.8rem;color:var(--muted);text-align:right}.offline{opacity:.55}.history{display:grid;gap:8px}.history-item{display:flex;align-items:center;gap:8px;padding:10px;background:#11182e;border-radius:12px;font-size:.9rem}.history-item .name{flex:1}.history-item .icons{font-size:1.3rem;white-space:nowrap}.points{font-weight:900;color:var(--gold);white-space:nowrap}.reset{width:100%;margin:4px 0 0;background:transparent;border-color:#5d6681}.center{text-align:center}.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:#f7f7ff;color:#15182a;padding:11px 16px;border-radius:12px;font-weight:700;box-shadow:0 8px 28px #0005;display:none;max-width:calc(100% - 28px);z-index:10}@media(min-width:520px){.connection{width:auto}.players{grid-template-columns:1fr 1fr}}
